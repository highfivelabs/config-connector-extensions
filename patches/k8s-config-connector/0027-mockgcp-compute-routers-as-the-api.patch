config-connector-extensions patch 0027: mockgcp's routers as the real API: MD5 key values unread, one feature per insert and update.

For compute.gcp.hfl.dev ComputeRouter. Written here:
- a router read with routers.get carries each of its
  md5AuthenticationKeys by name only, without the key, as the real API
  does (Terraform's google_compute_router_peer reads it so: "key value
  is not returned as it is a sensitive field"); the stored router keeps
  the key;
- routers.insert refuses a router with more than one of interfaces, BGP
  peers, NATs and MD5 keys with the API's own 400, "Creating a router
  with multiple features is currently unsupported." (a live run,
  docs/live-runs.md); which combinations the API allows is not known;
- routers.update refuses a change of more than one of the interfaces,
  the BGP peers with the MD5 keys, and the NATs, with the API's own 400,
  "Updating multiple Router features is currently unsupported." (a live
  run); peers and keys count as one, as Terraform writes them together.
Upstream candidate: yes.

diff --git a/mockgcp/mockcompute/routersv1.go b/mockgcp/mockcompute/routersv1.go
index 7c11d712..f1c459a1 100644
--- a/mockgcp/mockcompute/routersv1.go
+++ b/mockgcp/mockcompute/routersv1.go
@@ -55,6 +55,12 @@ func (s *RoutersV1) Get(ctx context.Context, req *pb.GetRouterRequest) (*pb.Rout
 		obj.EncryptedInterconnectRouter = nil
 	}
 
+	// The API keeps an MD5 authentication key's value but never returns it:
+	// a read has each key's name only.
+	for _, key := range obj.Md5AuthenticationKeys {
+		key.Key = nil
+	}
+
 	return obj, nil
 }
 
@@ -67,6 +73,20 @@ func (s *RoutersV1) Insert(ctx context.Context, req *pb.InsertRouterRequest) (*p
 
 	fqn := name.String()
 
+	// The API refuses to insert a router with more than one feature (seen
+	// with interfaces, BGP peers, NATs and MD5 keys together; which
+	// combinations it allows is not known, so any two are refused here).
+	r := req.GetRouterResource()
+	features := 0
+	for _, n := range []int{len(r.Interfaces), len(r.BgpPeers), len(r.Nats), len(r.Md5AuthenticationKeys)} {
+		if n > 0 {
+			features++
+		}
+	}
+	if features > 1 {
+		return nil, status.Errorf(codes.InvalidArgument, "Creating a router with multiple features is currently unsupported.")
+	}
+
 	id := s.generateID()
 
 	obj := proto.CloneOf(req.GetRouterResource())
@@ -191,6 +211,26 @@ func (s *RoutersV1) Update(ctx context.Context, req *pb.UpdateRouterRequest) (*p
 		return nil, err
 	}
 
+	// The API refuses an update of more than one feature (seen live). Here
+	// the features are the interfaces, the BGP peers with the MD5 keys (as
+	// Terraform's google_compute_router_peer writes them together), and the
+	// NATs; which others count is not known.
+	r := req.GetRouterResource()
+	var changed []string
+	if !proto.Equal(&pb.Router{Interfaces: existing.Interfaces}, &pb.Router{Interfaces: r.Interfaces}) {
+		changed = append(changed, "interfaces")
+	}
+	if !proto.Equal(&pb.Router{BgpPeers: existing.BgpPeers, Md5AuthenticationKeys: existing.Md5AuthenticationKeys}, &pb.Router{BgpPeers: r.BgpPeers, Md5AuthenticationKeys: r.Md5AuthenticationKeys}) {
+		changed = append(changed, "bgpPeers")
+	}
+	if !proto.Equal(&pb.Router{Nats: existing.Nats}, &pb.Router{Nats: r.Nats}) {
+		changed = append(changed, "nats")
+	}
+	if len(changed) > 1 {
+		// The API's message, and (ours) the features that changed.
+		return nil, status.Errorf(codes.InvalidArgument, "Updating multiple Router features is currently unsupported. (mockgcp: %s changed)", strings.Join(changed, ", "))
+	}
+
 	updated := proto.Clone(req.GetRouterResource()).(*pb.Router)
 	updated.SelfLink = existing.SelfLink
 	updated.CreationTimestamp = existing.CreationTimestamp
