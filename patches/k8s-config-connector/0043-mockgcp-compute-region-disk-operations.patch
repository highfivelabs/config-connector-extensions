config-connector-extensions patch 0043: mockgcp answers a regional disk's insert and delete with a regional operation.

mockgcp returned a global operation for regionDisks.insert and
regionDisks.delete, which a client waiting on the operation looks up in
regionOperations and does not find (404 "operation ... not found"; the
Go REST client's Wait). The API answers both with a regional operation,
as mockgcp already does for addResourcePolicies and
removeResourcePolicies. Found by ComputeRegionDiskResourcePolicyAttachment's
test, which makes regional disks through the API.

diff --git a/mockgcp/mockcompute/regiondisksv1.go b/mockgcp/mockcompute/regiondisksv1.go
--- a/mockgcp/mockcompute/regiondisksv1.go
+++ b/mockgcp/mockcompute/regiondisksv1.go
@@ -80,7 +80,17 @@
 		return nil, err
 	}
 
-	return s.newLRO(ctx, name.Project.ID)
+	// A regional disk's operations are regional (regionOperations), as
+	// the API's are; a global one is not found by a client that waits.
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo("insert"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startRegionalLRO(ctx, name.Project.ID, name.Region, op, func() (proto.Message, error) {
+		return obj, nil
+	})
 }
 
 // Updates a disk resource in the specified project using the data included in the request.
@@ -121,7 +131,15 @@
 		return nil, err
 	}
 
-	return s.newLRO(ctx, name.Project.ID)
+	op := &pb.Operation{
+		TargetId:      deleted.Id,
+		TargetLink:    deleted.SelfLink,
+		OperationType: PtrTo("delete"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startRegionalLRO(ctx, name.Project.ID, name.Region, op, func() (proto.Message, error) {
+		return deleted, nil
+	})
 }
 
 func (s *RegionalDisksV1) Resize(ctx context.Context, req *pb.ResizeRegionDiskRequest) (*pb.Operation, error) {
