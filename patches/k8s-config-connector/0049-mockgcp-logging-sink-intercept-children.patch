diff --git a/mockgcp/mocklogging/sinkintercept.go b/mockgcp/mocklogging/sinkintercept.go
new file mode 100644
index 0000000..afbda34
--- /dev/null
+++ b/mockgcp/mocklogging/sinkintercept.go
@@ -0,0 +1,198 @@
+// Copyright 2026 High Five Labs
