+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mocklogging
+
+// A log sink's interceptChildren: the REST API has the field, but the
+// LogSink protobuf at cloud.google.com/go/logging v1.18.0 has not, so the
+// gRPC gateway drops it. The HTTP layer keeps it beside the sink, checks
+// the API's rules for it when a sink is made (a folder's or organization's
+// sink only, with includeChildren true and a Cloud project destination,
+// logging.googleapis.com/projects/{project}), and adds it to every sink
+// it serves. An update that names it in its mask may not change it.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+var projectSinkDestination = regexp.MustCompile(`^logging\.googleapis\.com/projects/[^/]+$`)
+
+type sinkIntercepts struct {
+	mu sync.Mutex
+	// by sink name, {projects|folders|organizations|billingAccounts}/{id}/sinks/{sink}
+	m map[string]bool
+}
+
+func (x *sinkIntercepts) get(name string) bool {
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	return x.m[name]
+}
+
+func (x *sinkIntercepts) set(name string, v bool) {
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	if x.m == nil {
+		x.m = map[string]bool{}
+	}
+	if v {
+		x.m[name] = true
+	} else {
+		delete(x.m, name)
+	}
+}
+
+func writeSinkError(w http.ResponseWriter, code int, status, msg string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(code)
+	b, _ := json.Marshal(map[string]any{"error": map[string]any{"code": code, "message": msg, "status": status}})
+	w.Write(b)
+}
+
+// serveSink handles a request for a log sink, or for a parent's sinks, and
+// says whether it did.
+func (s *MockService) serveSink(w http.ResponseWriter, r *http.Request, next http.Handler) bool {
+	tokens := strings.Split(strings.TrimPrefix(r.URL.Path, "/v2/"), "/")
+	if len(tokens) < 3 || tokens[2] != "sinks" || len(tokens) > 4 {
+		return false
+	}
+	switch tokens[0] {
+	case "projects", "folders", "organizations", "billingAccounts":
+	default:
+		return false
+	}
+	parent := tokens[0] + "/" + tokens[1]
+	item := len(tokens) == 4
+
+	var body map[string]any
+	var raw []byte
+	if r.Body != nil && (r.Method == http.MethodPost || r.Method == http.MethodPut || r.Method == http.MethodPatch) {
+		var err error
+		raw, err = io.ReadAll(r.Body)
+		if err != nil {
+			writeSinkError(w, http.StatusBadRequest, "INVALID_ARGUMENT", err.Error())
+			return true
+		}
+		r.Body = io.NopCloser(bytes.NewReader(raw))
+		if len(raw) > 0 {
+			if err := json.Unmarshal(raw, &body); err != nil {
+				return false
+			}
+		}
+	}
+	intercept, _ := body["interceptChildren"].(bool)
+
+	name := ""
+	switch {
+	case !item && r.Method == http.MethodPost:
+		sinkName, _ := body["name"].(string)
+		name = parent + "/sinks/" + sinkName
+		if intercept {
+			if tokens[0] != "folders" && tokens[0] != "organizations" {
+				writeSinkError(w, http.StatusBadRequest, "INVALID_ARGUMENT", "interceptChildren is only allowed for a folder's or an organization's sink")
+				return true
+			}
+			if include, _ := body["includeChildren"].(bool); !include {
+				writeSinkError(w, http.StatusBadRequest, "INVALID_ARGUMENT", "interceptChildren needs includeChildren to be true")
+				return true
+			}
+			if dest, _ := body["destination"].(string); !projectSinkDestination.MatchString(dest) {
+				writeSinkError(w, http.StatusBadRequest, "INVALID_ARGUMENT", fmt.Sprintf("an intercepting sink's destination must be a Cloud project, logging.googleapis.com/projects/[PROJECT_ID], not %q", dest))
+				return true
+			}
+		}
+	case item && (r.Method == http.MethodPut || r.Method == http.MethodPatch):
+		name = parent + "/sinks/" + tokens[3]
+		q := r.URL.Query()
+		var kept []string
+		named := false
+		for _, p := range strings.Split(q.Get("updateMask"), ",") {
+			switch p {
+			case "":
+			case "interceptChildren", "intercept_children":
+				named = true
+			default:
+				kept = append(kept, p)
+			}
+		}
+		if named {
+			if intercept != s.sinkIntercepts.get(name) {
+				writeSinkError(w, http.StatusBadRequest, "INVALID_ARGUMENT", "interceptChildren cannot be changed by mockgcp")
+				return true
+			}
+			if len(kept) == 0 {
+				// Nothing else to update: answer with the sink.
+				r.Method, r.Body, raw = http.MethodGet, http.NoBody, nil
+				q.Del("updateMask")
+			} else {
+				q.Set("updateMask", strings.Join(kept, ","))
+			}
+			r.URL.RawQuery = q.Encode()
+		}
+	case item:
+		name = parent + "/sinks/" + tokens[3]
+	}
+
+	rec := httptest.NewRecorder()
+	next.ServeHTTP(rec, r)
+	out := rec.Body.Bytes()
+	if rec.Code >= 200 && rec.Code < 300 {
+		switch {
+		case !item && r.Method == http.MethodPost:
+			s.sinkIntercepts.set(name, intercept)
+		case item && r.Method == http.MethodDelete:
+			s.sinkIntercepts.set(name, false)
+		}
+		var resp map[string]any
+		if err := json.Unmarshal(out, &resp); err == nil && resp != nil {
+			changed := false
+			if sinks, ok := resp["sinks"].([]any); ok {
+				for _, e := range sinks {
+					if m, ok := e.(map[string]any); ok {
+						if n, _ := m["name"].(string); s.sinkIntercepts.get(parent + "/sinks/" + n) {
+							m["interceptChildren"] = true
+							changed = true
+						}
+					}
+				}
+			} else if name != "" && s.sinkIntercepts.get(name) {
+				resp["interceptChildren"] = true
+				changed = true
+			}
+			if changed {
+				if b, err := json.Marshal(resp); err == nil {
+					out = b
+				}
+			}
+		}
+	}
+	for k, v := range rec.Header() {
+		if k == "Content-Length" {
+			continue
+		}
+		w.Header()[k] = v
+	}
+	w.WriteHeader(rec.Code)
+	w.Write(out)
+	return true
+}
