+
+// applyServiceUpdateMask copies each masked top-level field (by its proto or
+// JSON name) from update to obj, clearing it when update leaves it unset.
+// Added by config-connector-extensions (patch 0008).
+func applyServiceUpdateMask(obj, update *pb.Service, paths []string) error {
+	fields := obj.ProtoReflect().Descriptor().Fields()
+	for _, path := range paths {
+		fd := fields.ByName(protoreflect.Name(path))
+		if fd == nil {
+			fd = fields.ByJSONName(path)
+		}
+		if fd == nil {
+			return status.Errorf(codes.InvalidArgument, "update_mask path %q is not a field of Service", path)
+		}
+		if update.ProtoReflect().Has(fd) {
+			obj.ProtoReflect().Set(fd, update.ProtoReflect().Get(fd))
+		} else {
+			obj.ProtoReflect().Clear(fd)
+		}
+	}
+	return nil
+}
