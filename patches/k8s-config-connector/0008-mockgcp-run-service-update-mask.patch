+// applyServiceUpdateMask copies each masked top-level field (by its proto or
+// JSON name) from update to obj, clearing it when update leaves it unset.
+// Added by config-connector-extensions (patch 0008).
+func applyServiceUpdateMask(obj, update *pb.Service, paths []string) error {
+	fields := obj.ProtoReflect().Descriptor().Fields()
+	for _, path := range paths {
+		fd := fields.ByName(protoreflect.Name(path))
+		if fd == nil {
+			fd = fields.ByJSONName(path)
+		}
+		if fd == nil {
+			return status.Errorf(codes.InvalidArgument, "update_mask path %q is not a field of Service", path)
+		}
+		if update.ProtoReflect().Has(fd) {
+			obj.ProtoReflect().Set(fd, update.ProtoReflect().Get(fd))
+		} else {
+			obj.ProtoReflect().Clear(fd)
+		}
+	}
+	return nil
+}
+
+// fillContainerDefaults gives each container what the real API fills in
+// when a template leaves it out (config-connector-extensions, seen in a
+// live run, docs/live-runs.md): an http1 port 8080 and a TCP startup probe
+// on it.
+func fillContainerDefaults(t *pb.RevisionTemplate) {
+	if t == nil {
+		return
+	}
+	for _, c := range t.Containers {
+		if len(c.Ports) == 0 {
+			c.Ports = []*pb.ContainerPort{{Name: "http1", ContainerPort: 8080}}
+		}
+		if c.StartupProbe == nil {
+			c.StartupProbe = &pb.Probe{
+				TimeoutSeconds:   240,
+				PeriodSeconds:    240,
+				FailureThreshold: 1,
+				ProbeType:        &pb.Probe_TcpSocket{TcpSocket: &pb.TCPSocketAction{Port: c.Ports[0].ContainerPort}},
+			}
+		}
+	}
+}
