@@ -72,6 +72,7 @@ func (s *MockService) Register(grpcServer *grpc.Server) {
 	pbv2.RegisterPoliciesServer(grpcServer, &IAMV2PoliciesServer{MockService: s})
 	pbv3.RegisterPrincipalAccessBoundaryPoliciesServer(grpcServer, &IAMV3PrincipalAccessBoundaryPoliciesServer{MockService: s})
 	pbv3.RegisterPolicyBindingsServer(grpcServer, &IAMV3PolicyBindingsServer{MockService: s})
+	pbv3.RegisterAccessPoliciesServer(grpcServer, &IAMV3AccessPoliciesServer{MockService: s})
 	pbwip.RegisterWorkloadIdentityPoolNamespacesServer(grpcServer, &WorkloadIdentityPoolNamespacesServer{MockService: s})
 	pbwip.RegisterWorkloadIdentityPoolManagedIdentitiesServer(grpcServer, &WorkloadIdentityPoolManagedIdentitiesServer{MockService: s})
 	pbwip.RegisterWorkloadIdentityPoolProviderKeysServer(grpcServer, &WorkloadIdentityPoolProviderKeysServer{MockService: s})
@@ -86,6 +87,7 @@ func (s *MockService) NewHTTPMux(ctx context.Context, conn *grpc.ClientConn) (ht
 		pbwip.RegisterWorkloadIdentityPoolProviderKeysHandler,
 		s.registerPrincipalAccessBoundaryPoliciesHTTP,
 		s.registerPolicyBindingsHTTP,
+		s.registerAccessPoliciesHTTP,
 		s.operations.RegisterOperationsPath("/v3/{prefix=**}/operations/{name}"),
 		s.operations.RegisterOperationsPath("/v1/{prefix=**}/operations/{name}"))
 	if err != nil {
diff --git a/mockgcp/mockiam/accesspolicies.go b/mockgcp/mockiam/accesspolicies.go
new file mode 100644
index 00000000..13f139f4
--- /dev/null
+++ b/mockgcp/mockiam/accesspolicies.go
@@ -0,0 +1,303 @@
+// Copyright 2026 High Five Labs
+// SPDX-License-Identifier: Apache-2.0
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
