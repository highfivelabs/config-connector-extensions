+)
+
+// RegionAutoscalersV1 serves regional autoscalers, as AutoscalersV1 serves
+// zonal ones: the target group must exist in the region, target and
+// region come back as full URLs, and the policy's defaults are filled in
+// (autoscalerDefaults).
+type RegionAutoscalersV1 struct {
+	*MockService
+	pb.UnimplementedRegionAutoscalersServer
+}
+
+type regionalAutoscalerName struct {
+	Project *projects.ProjectData
+	Region  string
+	Name    string
+}
+
+func (n *regionalAutoscalerName) String() string {
+	return "projects/" + n.Project.ID + "/regions/" + n.Region + "/autoscalers/" + n.Name
+}
+
+func (s *MockService) newRegionalAutoscalerName(project, region, name string) (*regionalAutoscalerName, error) {
+	p, err := s.Projects.GetProjectByID(project)
+	if err != nil {
+		return nil, err
+	}
+	return &regionalAutoscalerName{Project: p, Region: region, Name: name}, nil
+}
+
+// target is the autoscaler's target group as the API returns it: a full
+// URL, after checking that the regional group exists.
+func (s *RegionAutoscalersV1) target(ctx context.Context, name *regionalAutoscalerName, target string) (string, error) {
+	path := target
+	if i := strings.Index(path, "projects/"); i >= 0 {
+		path = path[i:]
+	} else {
+		path = fmt.Sprintf("projects/%s/regions/%s/instanceGroupManagers/%s", name.Project.ID, name.Region, path)
+	}
+	igm, err := s.parseRegionalIGMName(path)
+	if err != nil {
+		return "", status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.target': '%s'.", target)
+	}
+	if err := s.storage.Get(ctx, igm.String(), &pb.InstanceGroupManager{}); err != nil {
+		return "", status.Errorf(codes.NotFound, "The resource '%s' was not found", igm.String())
+	}
+	return BuildComputeSelfLink(ctx, igm.String()), nil
+}
+
+func (s *RegionAutoscalersV1) Get(ctx context.Context, req *pb.GetRegionAutoscalerRequest) (*pb.Autoscaler, error) {
+	name, err := s.newRegionalAutoscalerName(req.GetProject(), req.GetRegion(), req.GetAutoscaler())
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+	obj := &pb.Autoscaler{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "The resource '%s' was not found", fqn)
+		}
+		return nil, err
+	}
+	return obj, nil
+}
+
+func (s *RegionAutoscalersV1) List(ctx context.Context, req *pb.ListRegionAutoscalersRequest) (*pb.RegionAutoscalerList, error) {
+	name, err := s.newRegionalAutoscalerName(req.GetProject(), req.GetRegion(), "")
+	if err != nil {
+		return nil, err
+	}
+	out := &pb.RegionAutoscalerList{}
+	kind := (&pb.Autoscaler{}).ProtoReflect().Descriptor()
+	if err := s.storage.List(ctx, kind, storage.ListOptions{Prefix: name.String()}, func(obj proto.Message) error {
+		out.Items = append(out.Items, obj.(*pb.Autoscaler))
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (s *RegionAutoscalersV1) Insert(ctx context.Context, req *pb.InsertRegionAutoscalerRequest) (*pb.Operation, error) {
+	name, err := s.newRegionalAutoscalerName(req.GetProject(), req.GetRegion(), req.GetAutoscalerResource().GetName())
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+
+	obj := proto.CloneOf(req.GetAutoscalerResource())
+	target, err := s.target(ctx, name, obj.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	obj.Target = PtrTo(target)
+	id := s.generateID()
+	obj.Id = &id
+	obj.Kind = PtrTo("compute#autoscaler")
+	obj.SelfLink = PtrTo(BuildComputeSelfLink(ctx, fqn))
+	obj.CreationTimestamp = PtrTo(s.nowString())
+	obj.Region = PtrTo(BuildComputeSelfLink(ctx, fmt.Sprintf("projects/%s/regions/%s", name.Project.ID, name.Region)))
+	obj.Zone = nil
+	obj.Status = PtrTo("ACTIVE")
+	autoscalerDefaults(obj)
+
+	if err := s.storage.Create(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo("compute.regionAutoscalers.insert"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startRegionalLRO(ctx, name.Project.ID, name.Region, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
+
+// write replaces the stored autoscaler's fields with those of the request
+// (update) or merges them in (patch), keeping what the API owns.
+func (s *RegionAutoscalersV1) write(ctx context.Context, project, region, autoscaler string, in *pb.Autoscaler, merge bool, opType string) (*pb.Operation, error) {
+	if autoscaler == "" {
+		autoscaler = in.GetName()
+	}
+	name, err := s.newRegionalAutoscalerName(project, region, autoscaler)
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+	existing := &pb.Autoscaler{}
+	if err := s.storage.Get(ctx, fqn, existing); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "The resource '%s' was not found", fqn)
+		}
+		return nil, err
+	}
+	var obj *pb.Autoscaler
+	if merge {
+		obj = proto.CloneOf(existing)
+		if in.Description != nil {
+			obj.Description = in.Description
+		}
+		if in.AutoscalingPolicy != nil {
+			obj.AutoscalingPolicy = proto.CloneOf(in.AutoscalingPolicy)
+		}
+		if in.Target != nil {
+			obj.Target = in.Target
+		}
+	} else {
+		obj = proto.CloneOf(in)
+	}
+	target, err := s.target(ctx, name, obj.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	obj.Target = PtrTo(target)
+	obj.Name = existing.Name
+	obj.Id = existing.Id
+	obj.Kind = existing.Kind
+	obj.SelfLink = existing.SelfLink
+	obj.CreationTimestamp = existing.CreationTimestamp
+	obj.Region = existing.Region
+	obj.Zone = nil
+	obj.Status = existing.Status
+	autoscalerDefaults(obj)
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo(opType),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startRegionalLRO(ctx, name.Project.ID, name.Region, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
+
+func (s *RegionAutoscalersV1) Patch(ctx context.Context, req *pb.PatchRegionAutoscalerRequest) (*pb.Operation, error) {
+	return s.write(ctx, req.GetProject(), req.GetRegion(), req.GetAutoscaler(), req.GetAutoscalerResource(), true, "compute.regionAutoscalers.patch")
+}
+
+func (s *RegionAutoscalersV1) Update(ctx context.Context, req *pb.UpdateRegionAutoscalerRequest) (*pb.Operation, error) {
+	return s.write(ctx, req.GetProject(), req.GetRegion(), req.GetAutoscaler(), req.GetAutoscalerResource(), false, "compute.regionAutoscalers.update")
+}
+
+func (s *RegionAutoscalersV1) Delete(ctx context.Context, req *pb.DeleteRegionAutoscalerRequest) (*pb.Operation, error) {
+	name, err := s.newRegionalAutoscalerName(req.GetProject(), req.GetRegion(), req.GetAutoscaler())
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+	deleted := &pb.Autoscaler{}
+	if err := s.storage.Delete(ctx, fqn, deleted); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "The resource '%s' was not found", fqn)
+		}
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      deleted.Id,
+		TargetLink:    deleted.SelfLink,
+		OperationType: PtrTo("compute.regionAutoscalers.delete"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startRegionalLRO(ctx, name.Project.ID, name.Region, op, func() (proto.Message, error) {
+		return deleted, nil
+	})
+}
