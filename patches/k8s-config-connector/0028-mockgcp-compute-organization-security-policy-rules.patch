config-connector-extensions patch 0028: mockgcp's organization security policy rules: addRule, getRule, patchRule, removeRule, with a FIREWALL rule's beta-only fields.

For compute.gcp.hfl.dev ComputeOrganizationSecurityPolicyRule. Written here:
- organizationSecurityPolicies.addRule, getRule, patchRule and
  removeRule (upstream's mock answers Unimplemented), after the regional
  network firewall policy's rules: a rule is addressed by its priority in
  the policy's list of rules; addRule refuses a rule without a priority
  or an action, or at a priority the policy has; getRule, patchRule and
  removeRule answer 400 "The security policy does not contain a rule at
  priority N" for a priority it has not (the wording of the firewall
  policies' answer, not seen from this API); patchRule replaces the rule
  whole (the real API's handling of fields a patch leaves out is not
  known); each change gives the policy a new fingerprint;
- a FIREWALL policy's rule has fields only the compute beta API has
  (direction, enableLogging, targetResources, targetServiceAccounts,
  match.config.destIpRanges and layer4Configs), and the v1 messages this
  mock is built on drop them. The HTTP layer keeps them by policy and
  priority from each addRule and patchRule that succeeds, puts them back
  into getRule and the policy's rules, and forgets them on removeRule and
  on the policy's delete (organizationsecuritypolicyrules.go).
Upstream candidate: the rule methods yes; the beta fields only as a
stopgap until the mock has the beta protos.

diff --git a/mockgcp/mockcompute/organizationsecuritypoliciesv1.go b/mockgcp/mockcompute/organizationsecuritypoliciesv1.go
index fdc81af9..9986c94d 100644
--- a/mockgcp/mockcompute/organizationsecuritypoliciesv1.go
+++ b/mockgcp/mockcompute/organizationsecuritypoliciesv1.go
@@ -370,3 +370,128 @@ func (s *OrganizationSecurityPoliciesV1) ListAssociations(ctx context.Context, r
 
 	return response, nil
 }
+
+// The rules of an organization security policy, written for
+// config-connector-extensions (patch 0028), after the regional network
+// firewall policy's (regionnetworkfirewallpolicies.go): addressed by
+// priority, in the policy's list of rules; each change gives the policy a
+// new fingerprint. A FIREWALL policy's rules have fields only the beta API
+// has (direction, layer4Configs, targets); the v1 messages here drop them,
+// and organizationsecuritypolicyrules.go keeps them beside the rule.
+
+func (s *OrganizationSecurityPoliciesV1) getPolicy(ctx context.Context, policy string) (*pb.SecurityPolicy, string, error) {
+	name, err := s.parseOrganizationSecurityPolicyName("locations/global/securityPolicies/" + policy)
+	if err != nil {
+		return nil, "", err
+	}
+	fqn := name.String()
+	obj := &pb.SecurityPolicy{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, "", status.Errorf(codes.NotFound, "The resource '%s' was not found", fqn)
+		}
+		return nil, "", err
+	}
+	return obj, fqn, nil
+}
+
+func noOrganizationSecurityPolicyRule(priority int32) error {
+	return status.Errorf(codes.InvalidArgument, "Invalid value for field 'priority': '%d'. The security policy does not contain a rule at priority %d.", priority, priority)
+}
+
+func (s *OrganizationSecurityPoliciesV1) GetRule(ctx context.Context, req *pb.GetRuleOrganizationSecurityPolicyRequest) (*pb.SecurityPolicyRule, error) {
+	obj, _, err := s.getPolicy(ctx, req.GetSecurityPolicy())
+	if err != nil {
+		return nil, err
+	}
+	for _, r := range obj.GetRules() {
+		if r.GetPriority() == req.GetPriority() {
+			return r, nil
+		}
+	}
+	return nil, noOrganizationSecurityPolicyRule(req.GetPriority())
+}
+
+func (s *OrganizationSecurityPoliciesV1) AddRule(ctx context.Context, req *pb.AddRuleOrganizationSecurityPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, err := s.getPolicy(ctx, req.GetSecurityPolicy())
+	if err != nil {
+		return nil, err
+	}
+	r := proto.Clone(req.GetSecurityPolicyRuleResource()).(*pb.SecurityPolicyRule)
+	if r.Priority == nil {
+		return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': ''. Priority is required.")
+	}
+	if r.GetAction() == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.action': ''. Action is required.")
+	}
+	for _, existing := range obj.GetRules() {
+		if existing.GetPriority() == r.GetPriority() {
+			return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': '%d'. The security policy already has a rule at priority %d.", r.GetPriority(), r.GetPriority())
+		}
+	}
+	r.Kind = PtrTo("compute#securityPolicyRule")
+	obj.Rules = append(obj.Rules, r)
+	return s.saveRuleChange(ctx, obj, fqn, "addRuleToOrganizationSecurityPolicy")
+}
+
+// PatchRule replaces the rule at the priority with the one sent (the real
+// API's handling of fields a patch leaves out is not known; the controller
+// sends every field).
+func (s *OrganizationSecurityPoliciesV1) PatchRule(ctx context.Context, req *pb.PatchRuleOrganizationSecurityPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, err := s.getPolicy(ctx, req.GetSecurityPolicy())
+	if err != nil {
+		return nil, err
+	}
+	found := false
+	for i, rule := range obj.GetRules() {
+		if rule.GetPriority() == req.GetPriority() {
+			found = true
+			r := proto.Clone(req.GetSecurityPolicyRuleResource()).(*pb.SecurityPolicyRule)
+			r.Priority = PtrTo(rule.GetPriority())
+			r.Kind = PtrTo("compute#securityPolicyRule")
+			obj.Rules[i] = r
+		}
+	}
+	if !found {
+		return nil, noOrganizationSecurityPolicyRule(req.GetPriority())
+	}
+	return s.saveRuleChange(ctx, obj, fqn, "patchRuleInOrganizationSecurityPolicy")
+}
+
+func (s *OrganizationSecurityPoliciesV1) RemoveRule(ctx context.Context, req *pb.RemoveRuleOrganizationSecurityPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, err := s.getPolicy(ctx, req.GetSecurityPolicy())
+	if err != nil {
+		return nil, err
+	}
+	found := false
+	var rules []*pb.SecurityPolicyRule
+	for _, rule := range obj.GetRules() {
+		if rule.GetPriority() == req.GetPriority() {
+			found = true
+			continue
+		}
+		rules = append(rules, rule)
+	}
+	if !found {
+		return nil, noOrganizationSecurityPolicyRule(req.GetPriority())
+	}
+	obj.Rules = rules
+	return s.saveRuleChange(ctx, obj, fqn, "removeRuleFromOrganizationSecurityPolicy")
+}
+
+func (s *OrganizationSecurityPoliciesV1) saveRuleChange(ctx context.Context, obj *pb.SecurityPolicy, fqn string, operationType string) (*pb.Operation, error) {
+	obj.Fingerprint = nil
+	obj.Fingerprint = PtrTo(computeFingerprint(obj))
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo(operationType),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startGlobalOrganizationLRO(ctx, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
diff --git a/mockgcp/mockcompute/organizationsecuritypolicyrules.go b/mockgcp/mockcompute/organizationsecuritypolicyrules.go
new file mode 100644
index 00000000..23a787a6
--- /dev/null
+++ b/mockgcp/mockcompute/organizationsecuritypolicyrules.go
@@ -0,0 +1,182 @@
+// Copyright 2026 High Five Labs
+// SPDX-License-Identifier: Apache-2.0
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
