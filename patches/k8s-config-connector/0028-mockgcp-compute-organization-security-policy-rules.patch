+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package mockcompute
+
+// Written for config-connector-extensions (patch 0028). A FIREWALL
+// organization security policy's rule has fields only the compute beta API
+// has: direction, enableLogging, targetResources, targetServiceAccounts, and
+// match.config's destIpRanges and layer4Configs. This mock serves beta as v1
+// (service.go), and the v1 messages drop those fields. So the HTTP layer
+// keeps them here, by policy and priority, from each addRule and patchRule
+// that succeeds, puts them back into getRule and the policy's rules, and
+// forgets them on removeRule and on the policy's delete.
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+const orgSecurityPoliciesPath = "/compute/v1/locations/global/securityPolicies/"
+
+var (
+	orgSecurityPolicyRuleBetaFields       = []string{"direction", "enableLogging", "targetResources", "targetServiceAccounts"}
+	orgSecurityPolicyRuleBetaConfigFields = []string{"destIpRanges", "layer4Configs"}
+)
+
+type orgSecurityPolicyRuleExtras struct {
+	mu sync.Mutex
+	// policy ID -> priority -> {"rule": {...}, "config": {...}}
+	rules map[string]map[int64]map[string]map[string]any
+}
+
+func newOrgSecurityPolicyRuleExtras() *orgSecurityPolicyRuleExtras {
+	return &orgSecurityPolicyRuleExtras{rules: map[string]map[int64]map[string]map[string]any{}}
+}
+
+// orgSecurityPolicyRequest is a request to an organization security policy
+// or one of its rule methods, read before it is served.
+type orgSecurityPolicyRequest struct {
+	policy   string
+	method   string // "", getRule, addRule, patchRule, removeRule, ...
+	priority *int64
+	extras   map[string]map[string]any
+}
+
+// readOrgSecurityPolicyRequest returns nil for any other request. It reads
+// (and restores) the body of addRule and patchRule.
+func readOrgSecurityPolicyRequest(r *http.Request) *orgSecurityPolicyRequest {
+	rest, ok := strings.CutPrefix(r.URL.Path, orgSecurityPoliciesPath)
+	if !ok || rest == "" {
+		return nil
+	}
+	policy, method, _ := strings.Cut(rest, "/")
+	req := &orgSecurityPolicyRequest{policy: policy, method: method}
+	if p := r.URL.Query().Get("priority"); p != "" {
+		if n, err := strconv.ParseInt(p, 10, 64); err == nil {
+			req.priority = &n
+		}
+	}
+	if r.Method == http.MethodPost && (method == "addRule" || method == "patchRule") && r.Body != nil {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			return req
+		}
+		r.Body = io.NopCloser(bytes.NewBuffer(body))
+		var rule map[string]any
+		if err := json.Unmarshal(body, &rule); err != nil {
+			return req
+		}
+		if method == "addRule" {
+			if p, ok := rule["priority"].(float64); ok {
+				n := int64(p)
+				req.priority = &n
+			} else {
+				req.priority = nil
+			}
+		}
+		req.extras = map[string]map[string]any{"rule": {}, "config": {}}
+		for _, f := range orgSecurityPolicyRuleBetaFields {
+			if v, ok := rule[f]; ok {
+				req.extras["rule"][f] = v
+			}
+		}
+		if match, ok := rule["match"].(map[string]any); ok {
+			if config, ok := match["config"].(map[string]any); ok {
+				for _, f := range orgSecurityPolicyRuleBetaConfigFields {
+					if v, ok := config[f]; ok {
+						req.extras["config"][f] = v
+					}
+				}
+			}
+		}
+	}
+	return req
+}
+
+// served records what a successful request changed, and returns the
+// response body with the kept fields put back.
+func (e *orgSecurityPolicyRuleExtras) served(r *http.Request, req *orgSecurityPolicyRequest, body []byte) []byte {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	switch {
+	case req.method == "" && r.Method == http.MethodDelete:
+		delete(e.rules, req.policy)
+	case (req.method == "addRule" || req.method == "patchRule") && req.priority != nil && req.extras != nil:
+		if e.rules[req.policy] == nil {
+			e.rules[req.policy] = map[int64]map[string]map[string]any{}
+		}
+		e.rules[req.policy][*req.priority] = req.extras
+	case req.method == "removeRule" && req.priority != nil:
+		delete(e.rules[req.policy], *req.priority)
+	case req.method == "getRule" && req.priority != nil && r.Method == http.MethodGet:
+		var rule map[string]any
+		if err := json.Unmarshal(body, &rule); err != nil {
+			return body
+		}
+		e.restore(req.policy, *req.priority, rule)
+		if out, err := json.Marshal(rule); err == nil {
+			return out
+		}
+	case req.method == "" && r.Method == http.MethodGet:
+		var policy map[string]any
+		if err := json.Unmarshal(body, &policy); err != nil {
+			return body
+		}
+		rules, _ := policy["rules"].([]any)
+		for _, x := range rules {
+			if rule, ok := x.(map[string]any); ok {
+				if p, ok := rule["priority"].(float64); ok {
+					e.restore(req.policy, int64(p), rule)
+				}
+			}
+		}
+		if out, err := json.Marshal(policy); err == nil {
+			return out
+		}
+	}
+	return body
+}
+
+func (e *orgSecurityPolicyRuleExtras) restore(policy string, priority int64, rule map[string]any) {
+	extras := e.rules[policy][priority]
+	if extras == nil {
+		return
+	}
+	for k, v := range extras["rule"] {
+		rule[k] = v
+	}
+	if len(extras["config"]) == 0 {
+		return
+	}
+	match, _ := rule["match"].(map[string]any)
+	if match == nil {
+		match = map[string]any{}
+		rule["match"] = match
+	}
+	config, _ := match["config"].(map[string]any)
+	if config == nil {
+		config = map[string]any{}
+		match["config"] = config
+	}
+	for k, v := range extras["config"] {
+		config[k] = v
+	}
+}
