+
+type responsePolicyRulesService struct {
+	*MockService
+	pb.UnimplementedResponsePolicyRulesServerServer
+}
+
+type responsePolicyRuleName struct {
+	Policy *responsePolicyName
+	Name   string
+}
+
+func (n *responsePolicyRuleName) String() string {
+	return n.Policy.String() + "/rules/" + n.Name
+}
+
+// ruleName is the rule's name, after checking its response policy exists:
+// the API answers 404 for a rule of a policy that does not.
+func (s *responsePolicyRulesService) ruleName(ctx context.Context, project, policy, rule string) (*responsePolicyRuleName, error) {
+	policyName, err := s.parseResponsePolicyName("projects/" + project + "/responsePolicies/" + policy)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.storage.Get(ctx, policyName.String(), &pb.ResponsePolicy{}); err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil, status.Errorf(codes.NotFound, "The 'parameters.responsePolicy' resource named '%s' does not exist.", policy)
+		}
+		return nil, err
+	}
+	if rule == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "Invalid value for 'entity.responsePolicyRule.ruleName': ''")
+	}
+	return &responsePolicyRuleName{Policy: policyName, Name: rule}, nil
+}
+
+func ruleNotFound(name *responsePolicyRuleName) error {
+	return status.Errorf(codes.NotFound, "The 'parameters.responsePolicyRule' resource named '%s' does not exist.", name.Name)
+}
+
+// checkRule makes the API's check that a rule has a DNS name.
+func checkRule(rule *pb.ResponsePolicyRule) error {
+	if rule.GetDnsName() == "" {
+		return status.Errorf(codes.InvalidArgument, "Invalid value for 'entity.responsePolicyRule.dnsName': ''")
+	}
+	return nil
+}
+
+func (s *responsePolicyRulesService) GetResponsePolicyRule(ctx context.Context, req *pb.GetResponsePolicyRuleRequest) (*pb.ResponsePolicyRule, error) {
+	name, err := s.ruleName(ctx, req.GetProject(), req.GetResponsePolicy(), req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	obj := &pb.ResponsePolicyRule{}
+	if err := s.storage.Get(ctx, name.String(), obj); err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil, ruleNotFound(name)
+		}
+		return nil, err
+	}
+	return obj, nil
+}
+
+func (s *responsePolicyRulesService) CreateResponsePolicyRule(ctx context.Context, req *pb.CreateResponsePolicyRuleRequest) (*pb.ResponsePolicyRule, error) {
+	name, err := s.ruleName(ctx, req.GetProject(), req.GetResponsePolicy(), req.GetResponsePolicyRule().GetRuleName())
+	if err != nil {
+		return nil, err
+	}
+	obj := proto.CloneOf(req.GetResponsePolicyRule())
+	if err := checkRule(obj); err != nil {
+		return nil, err
+	}
+	obj.Kind = PtrTo("dns#responsePolicyRule")
+	if err := s.storage.Create(ctx, name.String(), obj); err != nil {
+		if apierrors.IsAlreadyExists(err) {
+			return nil, status.Errorf(codes.AlreadyExists, "The resource 'entity.responsePolicyRule' named '%s' already exists", name.Name)
+		}
+		return nil, err
+	}
+	return obj, nil
+}
+
+// replace writes rule over the stored one, keeping its name and kind.
+func (s *responsePolicyRulesService) replace(ctx context.Context, name *responsePolicyRuleName, rule *pb.ResponsePolicyRule) (*pb.ResponsePolicyRule, error) {
+	existing := &pb.ResponsePolicyRule{}
+	if err := s.storage.Get(ctx, name.String(), existing); err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil, ruleNotFound(name)
+		}
+		return nil, err
+	}
+	if err := checkRule(rule); err != nil {
+		return nil, err
+	}
+	rule.RuleName = existing.RuleName
+	rule.Kind = existing.Kind
+	if err := s.storage.Update(ctx, name.String(), rule); err != nil {
+		return nil, err
+	}
+	return rule, nil
+}
+
+func (s *responsePolicyRulesService) UpdateResponsePolicyRule(ctx context.Context, req *pb.UpdateResponsePolicyRuleRequest) (*pb.ResponsePolicyRulesUpdateResponse, error) {
+	name, err := s.ruleName(ctx, req.GetProject(), req.GetResponsePolicy(), req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	updated, err := s.replace(ctx, name, proto.CloneOf(req.GetResponsePolicyRule()))
+	if err != nil {
+		return nil, err
+	}
+	return &pb.ResponsePolicyRulesUpdateResponse{ResponsePolicyRule: updated}, nil
+}
+
+// PatchResponsePolicyRule changes the fields the request sets.
+func (s *responsePolicyRulesService) PatchResponsePolicyRule(ctx context.Context, req *pb.PatchResponsePolicyRuleRequest) (*pb.ResponsePolicyRulesPatchResponse, error) {
+	name, err := s.ruleName(ctx, req.GetProject(), req.GetResponsePolicy(), req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	existing := &pb.ResponsePolicyRule{}
+	if err := s.storage.Get(ctx, name.String(), existing); err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil, ruleNotFound(name)
+		}
+		return nil, err
+	}
+	patch := req.GetResponsePolicyRule()
+	updated := proto.CloneOf(existing)
+	if patch.DnsName != nil {
+		updated.DnsName = patch.DnsName
+	}
+	if patch.Behavior != nil {
+		updated.Behavior = patch.Behavior
+	}
+	if patch.LocalData != nil {
+		updated.LocalData = patch.LocalData
+	}
+	updated, err = s.replace(ctx, name, updated)
+	if err != nil {
+		return nil, err
+	}
+	return &pb.ResponsePolicyRulesPatchResponse{ResponsePolicyRule: updated}, nil
+}
+
+func (s *responsePolicyRulesService) DeleteResponsePolicyRule(ctx context.Context, req *pb.DeleteResponsePolicyRuleRequest) (*emptypb.Empty, error) {
+	name, err := s.ruleName(ctx, req.GetProject(), req.GetResponsePolicy(), req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	if err := s.storage.Delete(ctx, name.String(), &pb.ResponsePolicyRule{}); err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil, ruleNotFound(name)
+		}
+		return nil, err
+	}
+	return &emptypb.Empty{}, nil
+}
+
+func (s *responsePolicyRulesService) ListResponsePolicyRules(ctx context.Context, req *pb.ListResponsePolicyRulesRequest) (*pb.ResponsePolicyRulesListResponse, error) {
+	policyName, err := s.parseResponsePolicyName("projects/" + req.GetProject() + "/responsePolicies/" + req.GetResponsePolicy())
+	if err != nil {
+		return nil, err
+	}
+	prefix := policyName.String() + "/rules/"
+	out := &pb.ResponsePolicyRulesListResponse{}
+	kind := (&pb.ResponsePolicyRule{}).ProtoReflect().Descriptor()
+	if err := s.storage.List(ctx, kind, storage.ListOptions{Prefix: prefix}, func(obj proto.Message) error {
+		out.ResponsePolicyRules = append(out.ResponsePolicyRules, obj.(*pb.ResponsePolicyRule))
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
