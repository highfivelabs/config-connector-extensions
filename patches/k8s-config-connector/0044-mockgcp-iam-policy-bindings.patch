diff --git a/mockgcp/mockiam/policybindings.go b/mockgcp/mockiam/policybindings.go
new file mode 100644
index 0000000..d6fa0f8
--- /dev/null
+++ b/mockgcp/mockiam/policybindings.go
@@ -0,0 +1,313 @@
+// Copyright 2026 High Five Labs
+// SPDX-License-Identifier: Apache-2.0
+//
