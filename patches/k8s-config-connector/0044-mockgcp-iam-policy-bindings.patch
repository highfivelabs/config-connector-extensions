+// limitations under the License.
+
+package mockiam
+
+// Written by High Five Labs (config-connector-extensions patch 0044): IAM v3
+// policy bindings of an organization, folder or project, which mockgcp did
+// not serve. As with the principal access boundary policies (patch 0030),
+// the REST paths are added to the mux by hand
+// (registerPolicyBindingsHTTP) and call the gRPC server's methods directly.
+// Create, update and delete answer a finished operation. A binding's
+// policy must exist here; its kind and uid are set from it.
+
+import (
+	"context"
+	"crypto/md5"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	pb "cloud.google.com/go/iam/apiv3/iampb"
+	"github.com/google/uuid"
+	"github.com/grpc-ecosystem/grpc-gateway/v2/runtime"
+	longrunningpb "google.golang.org/genproto/googleapis/longrunning"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/emptypb"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/common/httpmux"
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/pkg/storage"
+)
+
+type IAMV3PolicyBindingsServer struct {
+	*MockService
+	pb.UnimplementedPolicyBindingsServer
+}
+
+// parsePolicyBindingParent checks {organizations|folders|projects}/{id}/locations/{location}.
+func parsePolicyBindingParent(parent string) (string, error) {
+	t := strings.Split(parent, "/")
+	if len(t) == 4 && (t[0] == "organizations" || t[0] == "folders" || t[0] == "projects") && t[1] != "" && t[2] == "locations" && t[3] != "" {
+		return parent, nil
+	}
+	return "", status.Errorf(codes.InvalidArgument, "parent %q is not {organizations|folders|projects}/{id}/locations/{location}", parent)
+}
+
+func parsePolicyBindingName(name string) (string, string, error) {
+	i := strings.Index(name, "/policyBindings/")
+	if i < 0 || strings.Contains(name[i+len("/policyBindings/"):], "/") || name[i+len("/policyBindings/"):] == "" {
+		return "", "", status.Errorf(codes.InvalidArgument, "name %q is not a policy binding name", name)
+	}
+	parent, err := parsePolicyBindingParent(name[:i])
+	if err != nil {
+		return "", "", err
+	}
+	return name, parent, nil
+}
+
+func policyBindingEtag(obj *pb.PolicyBinding) string {
+	c := proto.CloneOf(obj)
+	c.Etag = ""
+	b, _ := proto.MarshalOptions{Deterministic: true}.Marshal(c)
+	sum := md5.Sum(b)
+	return "W/\"" + base64.StdEncoding.EncodeToString(sum[:]) + "\""
+}
+
+func (s *IAMV3PolicyBindingsServer) GetPolicyBinding(ctx context.Context, req *pb.GetPolicyBindingRequest) (*pb.PolicyBinding, error) {
+	fqn, _, err := parsePolicyBindingName(req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	obj := &pb.PolicyBinding{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+		}
+		return nil, err
+	}
+	return obj, nil
+}
+
+func (s *IAMV3PolicyBindingsServer) ListPolicyBindings(ctx context.Context, req *pb.ListPolicyBindingsRequest) (*pb.ListPolicyBindingsResponse, error) {
+	parent, err := parsePolicyBindingParent(req.GetParent())
+	if err != nil {
+		return nil, err
+	}
+	response := &pb.ListPolicyBindingsResponse{}
+	kind := (&pb.PolicyBinding{}).ProtoReflect().Descriptor()
+	if err := s.storage.List(ctx, kind, storage.ListOptions{Prefix: parent + "/policyBindings/"}, func(obj proto.Message) error {
+		response.PolicyBindings = append(response.PolicyBindings, obj.(*pb.PolicyBinding))
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return response, nil
+}
+
+func (s *IAMV3PolicyBindingsServer) CreatePolicyBinding(ctx context.Context, req *pb.CreatePolicyBindingRequest) (*longrunningpb.Operation, error) {
+	parent, err := parsePolicyBindingParent(req.GetParent())
+	if err != nil {
+		return nil, err
+	}
+	if req.GetPolicyBindingId() == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "policy_binding_id is required")
+	}
+	fqn := parent + "/policyBindings/" + req.GetPolicyBindingId()
+	obj := proto.CloneOf(req.GetPolicyBinding())
+	if obj == nil {
+		obj = &pb.PolicyBinding{}
+	}
+	if obj.GetTarget().GetPrincipalSet() == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "target.principal_set is required")
+	}
+	if obj.GetPolicy() == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "policy is required")
+	}
+	// Only principal access boundary policies are served here.
+	policy, err := parsePABName(obj.GetPolicy())
+	if err != nil {
+		return nil, status.Errorf(codes.InvalidArgument, "policy %q is not a principal access boundary policy", obj.GetPolicy())
+	}
+	pab := &pb.PrincipalAccessBoundaryPolicy{}
+	if err := s.storage.Get(ctx, policy, pab); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "Policy %q was not found.", policy)
+		}
+		return nil, err
+	}
+	switch obj.GetPolicyKind() {
+	case pb.PolicyBinding_POLICY_KIND_UNSPECIFIED:
+		obj.PolicyKind = pb.PolicyBinding_PRINCIPAL_ACCESS_BOUNDARY
+	case pb.PolicyBinding_PRINCIPAL_ACCESS_BOUNDARY:
+	default:
+		return nil, status.Errorf(codes.InvalidArgument, "policy_kind %v does not match the policy's kind PRINCIPAL_ACCESS_BOUNDARY", obj.GetPolicyKind())
+	}
+	now := time.Now()
+	obj.Name = fqn
+	obj.Uid = uuid.NewString()
+	obj.PolicyUid = pab.GetUid()
+	obj.CreateTime = timestamppb.New(now)
+	obj.UpdateTime = timestamppb.New(now)
+	obj.Etag = policyBindingEtag(obj)
+	if err := s.storage.Create(ctx, fqn, obj); err != nil {
+		if status.Code(err) == codes.AlreadyExists {
+			return nil, status.Errorf(codes.AlreadyExists, "Policy binding %q already exists.", fqn)
+		}
+		return nil, err
+	}
+	md := &pb.OperationMetadata{CreateTime: timestamppb.New(now), EndTime: timestamppb.New(now), Target: fqn, Verb: "create", ApiVersion: "v3"}
+	return s.operations.DoneLRO(ctx, parent, md, obj)
+}
+
+func (s *IAMV3PolicyBindingsServer) UpdatePolicyBinding(ctx context.Context, req *pb.UpdatePolicyBindingRequest) (*longrunningpb.Operation, error) {
+	fqn, parent, err := parsePolicyBindingName(req.GetPolicyBinding().GetName())
+	if err != nil {
+		return nil, err
+	}
+	obj := &pb.PolicyBinding{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	in := req.GetPolicyBinding()
+	if in.GetEtag() != "" && in.GetEtag() != obj.GetEtag() {
+		return nil, status.Errorf(codes.Aborted, "The etag does not match the policy binding's.")
+	}
+	paths := req.GetUpdateMask().GetPaths()
+	if len(paths) == 0 {
+		paths = []string{"display_name", "annotations", "condition"}
+	}
+	for _, p := range paths {
+		switch p {
+		case "display_name", "displayName":
+			obj.DisplayName = in.GetDisplayName()
+		case "annotations":
+			obj.Annotations = in.GetAnnotations()
+		case "condition":
+			obj.Condition = in.GetCondition()
+		default:
+			return nil, status.Errorf(codes.InvalidArgument, "update_mask path %q is not supported (immutable)", p)
+		}
+	}
+	now := time.Now()
+	obj.UpdateTime = timestamppb.New(now)
+	obj.Etag = policyBindingEtag(obj)
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	md := &pb.OperationMetadata{CreateTime: timestamppb.New(now), EndTime: timestamppb.New(now), Target: fqn, Verb: "update", ApiVersion: "v3"}
+	return s.operations.DoneLRO(ctx, parent, md, obj)
+}
+
+func (s *IAMV3PolicyBindingsServer) DeletePolicyBinding(ctx context.Context, req *pb.DeletePolicyBindingRequest) (*longrunningpb.Operation, error) {
+	fqn, parent, err := parsePolicyBindingName(req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	deleted := &pb.PolicyBinding{}
+	if err := s.storage.Delete(ctx, fqn, deleted); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+		}
+		return nil, err
+	}
+	now := time.Now()
+	md := &pb.OperationMetadata{CreateTime: timestamppb.New(now), EndTime: timestamppb.New(now), Target: fqn, Verb: "delete", ApiVersion: "v3"}
+	return s.operations.DoneLRO(ctx, parent, md, &emptypb.Empty{})
+}
+
+// registerPolicyBindingsHTTP adds the v3 REST paths, for each parent.
+func (s *MockService) registerPolicyBindingsHTTP(ctx context.Context, mux *runtime.ServeMux, conn *grpc.ClientConn) error {
+	srv := &IAMV3PolicyBindingsServer{MockService: s}
+	write := func(w http.ResponseWriter, r *http.Request, msg proto.Message, err error) {
+		if err != nil {
+			runtime.HTTPError(r.Context(), mux, &runtime.JSONPb{}, w, r, err)
+			return
+		}
+		b, err := httpmux.MarshalAsJSON(msg)
+		if err != nil {
+			runtime.HTTPError(r.Context(), mux, &runtime.JSONPb{}, w, r, err)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		w.Write(b)
+	}
+	body := func(r *http.Request) (*pb.PolicyBinding, error) {
+		b, err := io.ReadAll(r.Body)
+		if err != nil {
+			return nil, status.Errorf(codes.InvalidArgument, "reading body: %v", err)
+		}
+		obj := &pb.PolicyBinding{}
+		if len(b) > 0 {
+			if err := (protojson.UnmarshalOptions{DiscardUnknown: true}).Unmarshal(b, obj); err != nil {
+				return nil, status.Errorf(codes.InvalidArgument, "parsing body: %v", err)
+			}
+		}
+		return obj, nil
+	}
+	for _, kind := range []string{"organizations", "folders", "projects"} {
+		kind := kind
+		coll := "/v3/" + kind + "/{parent}/locations/{loc}/policyBindings"
+		parentOf := func(p map[string]string) string {
+			return fmt.Sprintf("%s/%s/locations/%s", kind, p["parent"], p["loc"])
+		}
+		nameOf := func(p map[string]string) string { return parentOf(p) + "/policyBindings/" + p["id"] }
+		for _, h := range []struct {
+			method, path string
+			fn           func(w http.ResponseWriter, r *http.Request, p map[string]string)
+		}{
+			{"POST", coll, func(w http.ResponseWriter, r *http.Request, p map[string]string) {
+				obj, err := body(r)
+				if err != nil {
+					write(w, r, nil, err)
+					return
+				}
+				op, err := srv.CreatePolicyBinding(r.Context(), &pb.CreatePolicyBindingRequest{
+					Parent: parentOf(p), PolicyBindingId: r.URL.Query().Get("policyBindingId"), PolicyBinding: obj,
+				})
+				write(w, r, op, err)
+			}},
+			{"GET", coll, func(w http.ResponseWriter, r *http.Request, p map[string]string) {
+				resp, err := srv.ListPolicyBindings(r.Context(), &pb.ListPolicyBindingsRequest{Parent: parentOf(p)})
+				write(w, r, resp, err)
+			}},
+			{"GET", coll + "/{id}", func(w http.ResponseWriter, r *http.Request, p map[string]string) {
+				obj, err := srv.GetPolicyBinding(r.Context(), &pb.GetPolicyBindingRequest{Name: nameOf(p)})
+				write(w, r, obj, err)
+			}},
+			{"PATCH", coll + "/{id}", func(w http.ResponseWriter, r *http.Request, p map[string]string) {
+				obj, err := body(r)
+				if err != nil {
+					write(w, r, nil, err)
+					return
+				}
+				obj.Name = nameOf(p)
+				req := &pb.UpdatePolicyBindingRequest{PolicyBinding: obj}
+				if m := r.URL.Query().Get("updateMask"); m != "" {
+					req.UpdateMask = fieldMask(m)
+				}
+				op, err := srv.UpdatePolicyBinding(r.Context(), req)
+				write(w, r, op, err)
+			}},
+			{"DELETE", coll + "/{id}", func(w http.ResponseWriter, r *http.Request, p map[string]string) {
+				op, err := srv.DeletePolicyBinding(r.Context(), &pb.DeletePolicyBindingRequest{Name: nameOf(p)})
+				write(w, r, op, err)
+			}},
+		} {
+			if err := mux.HandlePath(h.method, h.path, h.fn); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
