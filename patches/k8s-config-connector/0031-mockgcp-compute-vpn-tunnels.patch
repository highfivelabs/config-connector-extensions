+package mockcompute
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"strings"
+
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/common/projects"
+	pb "github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/generated/mockgcp/cloud/compute/v1"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+)
+
+// VpnTunnelsV1 serves regional VPN tunnels: insert, get, setLabels and
+// delete. Every field but the labels is set only by insert. The shared
+// secret is never returned; its hash is.
+type VpnTunnelsV1 struct {
+	*MockService
+	pb.UnimplementedVpnTunnelsServer
+}
+
+func (s *VpnTunnelsV1) Get(ctx context.Context, req *pb.GetVpnTunnelRequest) (*pb.VpnTunnel, error) {
+	name, err := s.parseVpnTunnelName("projects/" + req.GetProject() + "/regions/" + req.GetRegion() + "/vpnTunnels/" + req.GetVpnTunnel())
+	if err != nil {
+		return nil, err
+	}
+
+	obj := &pb.VpnTunnel{}
+	if err := s.storage.Get(ctx, name.String(), obj); err != nil {
+		return nil, err
+	}
+
+	return obj, nil
+}
+
+func (s *VpnTunnelsV1) Insert(ctx context.Context, req *pb.InsertVpnTunnelRequest) (*pb.Operation, error) {
+	name, err := s.parseVpnTunnelName("projects/" + req.GetProject() + "/regions/" + req.GetRegion() + "/vpnTunnels/" + req.GetVpnTunnelResource().GetName())
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+
+	obj := proto.CloneOf(req.GetVpnTunnelResource())
+	if obj.GetSharedSecret() == "" {
+		return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.sharedSecret': ''. The shared secret must not be empty.")
+	}
+	if (obj.GetVpnGateway() == "") == (obj.GetTargetVpnGateway() == "") {
+		return nil, status.Errorf(codes.InvalidArgument, "Exactly one of vpnGateway and targetVpnGateway must be set.")
+	}
+	hash := sha256.Sum256([]byte(obj.GetSharedSecret()))
+	obj.SharedSecretHash = PtrTo(base64.RawStdEncoding.EncodeToString(hash[:])[:27])
+	obj.SharedSecret = nil
+
+	id := s.generateID()
+	obj.Id = &id
+	obj.SelfLink = PtrTo(BuildComputeSelfLink(ctx, fqn))
+	obj.CreationTimestamp = PtrTo(s.nowString())
+	obj.Kind = PtrTo("compute#vpnTunnel")
+	obj.Region = PtrTo(BuildComputeSelfLink(ctx, "projects/"+name.Project.ID+"/regions/"+name.Region))
+	obj.LabelFingerprint = PtrTo(labelsFingerprint(obj.GetLabels()))
+	obj.Status = PtrTo("FIRST_HANDSHAKE")
+	obj.DetailedStatus = PtrTo("Waiting for the first handshake.")
+	if obj.IkeVersion == nil {
+		obj.IkeVersion = PtrTo(int32(2))
+	}
+
+	if err := s.storage.Create(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+
+	return s.newLRO(ctx, name.Project.ID)
+}
+
+func (s *VpnTunnelsV1) SetLabels(ctx context.Context, req *pb.SetLabelsVpnTunnelRequest) (*pb.Operation, error) {
+	name, err := s.parseVpnTunnelName("projects/" + req.GetProject() + "/regions/" + req.GetRegion() + "/vpnTunnels/" + req.GetResource())
+	if err != nil {
+		return nil, err
+	}
+	fqn := name.String()
+
+	obj := &pb.VpnTunnel{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	if obj.GetLabelFingerprint() != req.GetRegionSetLabelsRequestResource().GetLabelFingerprint() {
+		return nil, status.Errorf(codes.FailedPrecondition, "Labels fingerprint either invalid or resource labels have changed")
+	}
+
+	obj.Labels = req.GetRegionSetLabelsRequestResource().GetLabels()
+	obj.LabelFingerprint = PtrTo(labelsFingerprint(obj.GetLabels()))
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+
+	return s.newLRO(ctx, name.Project.ID)
+}
+
+func (s *VpnTunnelsV1) Delete(ctx context.Context, req *pb.DeleteVpnTunnelRequest) (*pb.Operation, error) {
+	name, err := s.parseVpnTunnelName("projects/" + req.GetProject() + "/regions/" + req.GetRegion() + "/vpnTunnels/" + req.GetVpnTunnel())
+	if err != nil {
+		return nil, err
+	}
+
+	deleted := &pb.VpnTunnel{}
+	if err := s.storage.Delete(ctx, name.String(), deleted); err != nil {
+		return nil, err
+	}
+
+	return s.newLRO(ctx, name.Project.ID)
+}
+
+type vpnTunnelName struct {
+	Project *projects.ProjectData
+	Region  string
+	Name    string
+}
+
+func (n *vpnTunnelName) String() string {
+	return "projects/" + n.Project.ID + "/regions/" + n.Region + "/vpnTunnels/" + n.Name
+}
+
+// parseVpnTunnelName parses projects/*/regions/*/vpnTunnels/*.
+func (s *MockService) parseVpnTunnelName(name string) (*vpnTunnelName, error) {
+	tokens := strings.Split(name, "/")
+	if len(tokens) == 6 && tokens[0] == "projects" && tokens[2] == "regions" && tokens[4] == "vpnTunnels" {
+		project, err := s.Projects.GetProjectByID(tokens[1])
+		if err != nil {
+			return nil, err
+		}
+		return &vpnTunnelName{Project: project, Region: tokens[3], Name: tokens[5]}, nil
+	}
+	return nil, status.Errorf(codes.InvalidArgument, "name %q is not valid", name)
+}
