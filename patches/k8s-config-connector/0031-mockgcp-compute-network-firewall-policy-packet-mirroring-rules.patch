+package mockcompute
+
+// Packet mirroring rules of a global network firewall policy
+// (networkFirewallPolicies.getPacketMirroringRule, addPacketMirroringRule,
+// patchPacketMirroringRule, removePacketMirroringRule), written for
+// config-connector-extensions after the policy's firewall rules above
+// (GetRule, AddRule, PatchRule, RemoveRule): a rule is addressed by its
+// priority in the policy's packetMirroringRules. A missing priority is a
+// 400, as for firewall rules; a priority already taken is refused on add.
+// A patch replaces the rule (the real API keeps lists the body leaves out;
+// a client that sends every field converges either way). tlsInspect is
+// refused, even false, as the real API refuses it (seen live). No default
+// rules are added and nothing else is checked of the match, the action or
+// the security profile group.
+
+import (
+	"context"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+
+	pb "github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/generated/mockgcp/cloud/compute/v1"
+)
+
+func packetMirroringRuleMissing(priority int32) error {
+	return status.Errorf(codes.InvalidArgument, "Invalid value for field 'priority': '%d'. The firewall policy does not contain a packet mirroring rule at priority %d.", priority, priority)
+}
+
+func checkPacketMirroringRule(r *pb.FirewallPolicyRule) error {
+	if r.TlsInspect != nil {
+		return status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.tlsInspect': '%t'. TLS Inspection cannot be set for packet mirroring rule.", r.GetTlsInspect())
+	}
+	return nil
+}
+
+func mockFieldValuesForPacketMirroringRule(r *pb.FirewallPolicyRule) {
+	r.RuleTupleCount = PtrTo(int32(2))
+	r.Kind = PtrTo("compute#packetMirroringRule")
+	if r.Description == nil {
+		r.Description = PtrTo("")
+	}
+}
+
+func (s *NetworkFirewallPoliciesV1) GetPacketMirroringRule(ctx context.Context, req *pb.GetPacketMirroringRuleNetworkFirewallPolicyRequest) (*pb.FirewallPolicyRule, error) {
+	obj, _, _, err := s.resolvePolicy(ctx, req.GetProject(), req.GetFirewallPolicy())
+	if err != nil {
+		return nil, err
+	}
+	for _, r := range obj.GetPacketMirroringRules() {
+		if r.GetPriority() == req.GetPriority() {
+			return r, nil
+		}
+	}
+	return nil, packetMirroringRuleMissing(req.GetPriority())
+}
+
+func (s *NetworkFirewallPoliciesV1) AddPacketMirroringRule(ctx context.Context, req *pb.AddPacketMirroringRuleNetworkFirewallPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, projectID, err := s.resolvePolicy(ctx, req.GetProject(), req.GetFirewallPolicy())
+	if err != nil {
+		return nil, err
+	}
+	r := proto.CloneOf(req.GetFirewallPolicyRuleResource())
+	if err := checkPacketMirroringRule(r); err != nil {
+		return nil, err
+	}
+	if r.Priority == nil {
+		return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': '0'. A priority is required.")
+	}
+	for _, have := range obj.GetPacketMirroringRules() {
+		if have.GetPriority() == r.GetPriority() {
+			return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': '%d'. The firewall policy already contains a packet mirroring rule at priority %d.", r.GetPriority(), r.GetPriority())
+		}
+	}
+	mockFieldValuesForPacketMirroringRule(r)
+	obj.PacketMirroringRules = append(obj.PacketMirroringRules, r)
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo("compute.networkFirewallPolicies.addPacketMirroringRule"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startGlobalLRO(ctx, projectID, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
+
+func (s *NetworkFirewallPoliciesV1) PatchPacketMirroringRule(ctx context.Context, req *pb.PatchPacketMirroringRuleNetworkFirewallPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, projectID, err := s.resolvePolicy(ctx, req.GetProject(), req.GetFirewallPolicy())
+	if err != nil {
+		return nil, err
+	}
+	if err := checkPacketMirroringRule(req.GetFirewallPolicyRuleResource()); err != nil {
+		return nil, err
+	}
+	found := false
+	for i, have := range obj.GetPacketMirroringRules() {
+		if have.GetPriority() == req.GetPriority() {
+			r := proto.CloneOf(req.GetFirewallPolicyRuleResource())
+			r.Priority = PtrTo(req.GetPriority())
+			mockFieldValuesForPacketMirroringRule(r)
+			obj.PacketMirroringRules[i] = r
+			found = true
+		}
+	}
+	if !found {
+		return nil, packetMirroringRuleMissing(req.GetPriority())
+	}
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo("compute.networkFirewallPolicies.patchPacketMirroringRule"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startGlobalLRO(ctx, projectID, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
+
+func (s *NetworkFirewallPoliciesV1) RemovePacketMirroringRule(ctx context.Context, req *pb.RemovePacketMirroringRuleNetworkFirewallPolicyRequest) (*pb.Operation, error) {
+	obj, fqn, projectID, err := s.resolvePolicy(ctx, req.GetProject(), req.GetFirewallPolicy())
+	if err != nil {
+		return nil, err
+	}
+	var kept []*pb.FirewallPolicyRule
+	for _, have := range obj.GetPacketMirroringRules() {
+		if have.GetPriority() != req.GetPriority() {
+			kept = append(kept, have)
+		}
+	}
+	if len(kept) == len(obj.GetPacketMirroringRules()) {
+		return nil, packetMirroringRuleMissing(req.GetPriority())
+	}
+	obj.PacketMirroringRules = kept
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo("compute.networkFirewallPolicies.removePacketMirroringRule"),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startGlobalLRO(ctx, projectID, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
