+// Added by config-connector-extensions (patch 0006): workload identity pool
+// namespaces, as the IAM v1 API documents them. A deleted namespace is
+// soft-deleted: it keeps its name with state DELETED for about 30 days and
+// can be undeleted, and its ID cannot be reused meanwhile. The parent pool
+// is not checked: mockgcp has no workload identity pools.
+
+package mockiam
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	longrunningpb "google.golang.org/genproto/googleapis/longrunning"
+
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/common/projects"
+	pbwip "github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/generated/mockgcp/iam/v1"
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/pkg/storage"
+)
+
+type WorkloadIdentityPoolNamespacesServer struct {
+	*MockService
+	pbwip.UnimplementedWorkloadIdentityPoolNamespacesServer
+}
+
+type namespaceName struct {
+	Project   *projects.ProjectData
+	Location  string
+	Pool      string
+	Namespace string
+}
+
+func (n *namespaceName) String() string {
+	return fmt.Sprintf("projects/%s/locations/%s/workloadIdentityPools/%s/namespaces/%s", n.Project.ID, n.Location, n.Pool, n.Namespace)
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) parseNamespaceName(name string) (*namespaceName, error) {
+	tokens := strings.Split(name, "/")
+	if len(tokens) != 8 || tokens[0] != "projects" || tokens[2] != "locations" || tokens[4] != "workloadIdentityPools" || tokens[6] != "namespaces" {
+		return nil, status.Errorf(codes.InvalidArgument, "name %q is not valid", name)
+	}
+	project, err := s.Projects.GetProjectByIDOrNumber(tokens[1])
+	if err != nil {
+		return nil, err
+	}
+	return &namespaceName{Project: project, Location: tokens[3], Pool: tokens[5], Namespace: tokens[7]}, nil
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) get(ctx context.Context, name string) (*namespaceName, *pbwip.WorkloadIdentityPoolNamespace, error) {
+	n, err := s.parseNamespaceName(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	obj := &pbwip.WorkloadIdentityPoolNamespace{}
+	if err := s.storage.Get(ctx, n.String(), obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+		}
+		return nil, nil, err
+	}
+	return n, obj, nil
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) lro(ctx context.Context, n *namespaceName, obj *pbwip.WorkloadIdentityPoolNamespace) (*longrunningpb.Operation, error) {
+	result := proto.Clone(obj).(*pbwip.WorkloadIdentityPoolNamespace)
+	return s.operations.StartLRO(ctx, n.String(), &pbwip.WorkloadIdentityPoolOperationMetadata{}, func() (proto.Message, error) {
+		return result, nil
+	})
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) GetWorkloadIdentityPoolNamespace(ctx context.Context, req *pbwip.GetWorkloadIdentityPoolNamespaceRequest) (*pbwip.WorkloadIdentityPoolNamespace, error) {
+	_, obj, err := s.get(ctx, req.GetName())
+	return obj, err
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) CreateWorkloadIdentityPoolNamespace(ctx context.Context, req *pbwip.CreateWorkloadIdentityPoolNamespaceRequest) (*longrunningpb.Operation, error) {
+	n, err := s.parseNamespaceName(req.GetParent() + "/namespaces/" + req.GetWorkloadIdentityPoolNamespaceId())
+	if err != nil {
+		return nil, err
+	}
+	obj := proto.Clone(req.GetWorkloadIdentityPoolNamespace()).(*pbwip.WorkloadIdentityPoolNamespace)
+	obj.Name = n.String()
+	obj.State = pbwip.WorkloadIdentityPoolNamespace_ACTIVE
+	obj.ExpireTime = nil
+	if err := s.storage.Create(ctx, n.String(), obj); err != nil {
+		if status.Code(err) == codes.AlreadyExists {
+			return nil, status.Errorf(codes.AlreadyExists, "Namespace %s already exists.", n.String())
+		}
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) UpdateWorkloadIdentityPoolNamespace(ctx context.Context, req *pbwip.UpdateWorkloadIdentityPoolNamespaceRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetWorkloadIdentityPoolNamespace().GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State == pbwip.WorkloadIdentityPoolNamespace_DELETED {
+		return nil, status.Errorf(codes.FailedPrecondition, "Namespace %s is deleted.", n.String())
+	}
+	for _, path := range req.GetUpdateMask().GetPaths() {
+		switch path {
+		case "description":
+			obj.Description = req.GetWorkloadIdentityPoolNamespace().GetDescription()
+		case "disabled":
+			obj.Disabled = req.GetWorkloadIdentityPoolNamespace().GetDisabled()
+		default:
+			return nil, status.Errorf(codes.InvalidArgument, "update_mask path %q not supported by mockgcp", path)
+		}
+	}
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) DeleteWorkloadIdentityPoolNamespace(ctx context.Context, req *pbwip.DeleteWorkloadIdentityPoolNamespaceRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State == pbwip.WorkloadIdentityPoolNamespace_DELETED {
+		return nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+	}
+	obj.State = pbwip.WorkloadIdentityPoolNamespace_DELETED
+	obj.ExpireTime = timestamppb.New(time.Now().Add(30 * 24 * time.Hour))
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) UndeleteWorkloadIdentityPoolNamespace(ctx context.Context, req *pbwip.UndeleteWorkloadIdentityPoolNamespaceRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State != pbwip.WorkloadIdentityPoolNamespace_DELETED {
+		return nil, status.Errorf(codes.FailedPrecondition, "Namespace %s is not deleted.", n.String())
+	}
+	obj.State = pbwip.WorkloadIdentityPoolNamespace_ACTIVE
+	obj.ExpireTime = nil
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolNamespacesServer) ListWorkloadIdentityPoolNamespaces(ctx context.Context, req *pbwip.ListWorkloadIdentityPoolNamespacesRequest) (*pbwip.ListWorkloadIdentityPoolNamespacesResponse, error) {
+	resp := &pbwip.ListWorkloadIdentityPoolNamespacesResponse{}
+	kind := (&pbwip.WorkloadIdentityPoolNamespace{}).ProtoReflect().Descriptor()
+	if err := s.storage.List(ctx, kind, storage.ListOptions{Prefix: req.GetParent() + "/namespaces/"}, func(obj proto.Message) error {
+		ns := obj.(*pbwip.WorkloadIdentityPoolNamespace)
+		if ns.State != pbwip.WorkloadIdentityPoolNamespace_DELETED || req.GetShowDeleted() {
+			resp.WorkloadIdentityPoolNamespaces = append(resp.WorkloadIdentityPoolNamespaces, ns)
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return resp, nil
+}
