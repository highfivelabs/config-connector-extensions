+package mockcompute
+
+// Packet mirroring rules of a hierarchical firewall policy
+// (firewallPolicies.getPacketMirroringRule, addPacketMirroringRule,
+// patchPacketMirroringRule, removePacketMirroringRule), written for
+// config-connector-extensions' ComputeFirewallPolicyPacketMirroringRule.
+// The calls are in the compute beta (and alpha) API only, so mockgcp's v1
+// protos have no RPC for them: they are served here on the HTTP layer,
+// before the beta-to-v1 rewrite, on the policy the v1 RPCs store
+// (locations/global/firewallPolicies/{id}), with the same rules as a
+// network firewall policy's (networkfirewallpolicypacketmirroringrules.go):
+// a rule is addressed by its priority, a missing priority is a 400, a
+// priority already taken is refused on add, a patch replaces the rule, and
+// tlsInspect and an INGRESS rule without a source are refused.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"regexp"
+	"strconv"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/common/httpmux"
+	pb "github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/generated/mockgcp/cloud/compute/v1"
+)
+
+var firewallPolicyPacketMirroringRulePath = regexp.MustCompile(`^/compute/(?:beta|alpha|v1)/locations/global/firewallPolicies/([^/]+)/(addPacketMirroringRule|getPacketMirroringRule|patchPacketMirroringRule|removePacketMirroringRule)$`)
+
+// serveFirewallPolicyPacketMirroringRule serves the call when r is one, and
+// reports whether it was.
+func (s *MockService) serveFirewallPolicyPacketMirroringRule(w http.ResponseWriter, r *http.Request) bool {
+	m := firewallPolicyPacketMirroringRulePath.FindStringSubmatch(r.URL.Path)
+	if m == nil {
+		return false
+	}
+	policy, method := m[1], m[2]
+	result, err := s.firewallPolicyPacketMirroringRule(r.Context(), r, policy, method)
+	if err != nil {
+		st, _ := status.FromError(err)
+		code := http.StatusInternalServerError
+		switch st.Code() {
+		case codes.InvalidArgument:
+			code = http.StatusBadRequest
+		case codes.NotFound:
+			code = http.StatusNotFound
+		}
+		body, _ := json.Marshal(map[string]any{"error": map[string]any{
+			"code": code, "message": st.Message(),
+			"errors": []any{map[string]any{"message": st.Message(), "domain": "global", "reason": "invalid"}},
+		}})
+		w.Header().Set("Content-Type", "application/json; charset=UTF-8")
+		w.WriteHeader(code)
+		w.Write(body)
+		return true
+	}
+	body, err := httpmux.MarshalAsJSON(result)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return true
+	}
+	w.Header().Set("Content-Type", "application/json; charset=UTF-8")
+	w.WriteHeader(http.StatusOK)
+	w.Write(body)
+	return true
+}
+
+func (s *MockService) firewallPolicyPacketMirroringRule(ctx context.Context, r *http.Request, policy, method string) (proto.Message, error) {
+	fqn := "locations/global/firewallPolicies/" + policy
+	obj := &pb.FirewallPolicy{}
+	if err := s.storage.Get(ctx, fqn, obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, status.Errorf(codes.NotFound, "The resource '%s' was not found", fqn)
+		}
+		return nil, err
+	}
+	var priority int32
+	if p := r.URL.Query().Get("priority"); p != "" {
+		v, err := strconv.ParseInt(p, 10, 32)
+		if err != nil {
+			return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'priority': '%s'.", p)
+		}
+		priority = int32(v)
+	}
+	readRule := func() (*pb.FirewallPolicyRule, error) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			return nil, err
+		}
+		rule := &pb.FirewallPolicyRule{}
+		if err := (protojson.UnmarshalOptions{DiscardUnknown: true}).Unmarshal(body, rule); err != nil {
+			return nil, status.Errorf(codes.InvalidArgument, "Invalid JSON payload received: %v", err)
+		}
+		return rule, checkPacketMirroringRule(rule)
+	}
+	opType := ""
+	switch method {
+	case "getPacketMirroringRule":
+		for _, have := range obj.GetPacketMirroringRules() {
+			if have.GetPriority() == priority {
+				return have, nil
+			}
+		}
+		return nil, packetMirroringRuleMissing(priority)
+	case "addPacketMirroringRule":
+		rule, err := readRule()
+		if err != nil {
+			return nil, err
+		}
+		if rule.Priority == nil {
+			return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': '0'. A priority is required.")
+		}
+		for _, have := range obj.GetPacketMirroringRules() {
+			if have.GetPriority() == rule.GetPriority() {
+				return nil, status.Errorf(codes.InvalidArgument, "Invalid value for field 'resource.priority': '%d'. The firewall policy already contains a packet mirroring rule at priority %d.", rule.GetPriority(), rule.GetPriority())
+			}
+		}
+		mockFieldValuesForPacketMirroringRule(rule)
+		obj.PacketMirroringRules = append(obj.PacketMirroringRules, rule)
+		opType = "addPacketMirroringRuleToFirewallPolicy"
+	case "patchPacketMirroringRule":
+		rule, err := readRule()
+		if err != nil {
+			return nil, err
+		}
+		found := false
+		for i, have := range obj.GetPacketMirroringRules() {
+			if have.GetPriority() == priority {
+				rule.Priority = PtrTo(priority)
+				mockFieldValuesForPacketMirroringRule(rule)
+				obj.PacketMirroringRules[i] = rule
+				found = true
+			}
+		}
+		if !found {
+			return nil, packetMirroringRuleMissing(priority)
+		}
+		opType = "patchPacketMirroringRuleInFirewallPolicy"
+	case "removePacketMirroringRule":
+		var kept []*pb.FirewallPolicyRule
+		for _, have := range obj.GetPacketMirroringRules() {
+			if have.GetPriority() != priority {
+				kept = append(kept, have)
+			}
+		}
+		if len(kept) == len(obj.GetPacketMirroringRules()) {
+			return nil, packetMirroringRuleMissing(priority)
+		}
+		obj.PacketMirroringRules = kept
+		opType = "removePacketMirroringRuleFromFirewallPolicy"
+	default:
+		return nil, fmt.Errorf("unknown method %q", method)
+	}
+	if err := s.storage.Update(ctx, fqn, obj); err != nil {
+		return nil, err
+	}
+	op := &pb.Operation{
+		TargetId:      obj.Id,
+		TargetLink:    obj.SelfLink,
+		OperationType: PtrTo(opType),
+		User:          PtrTo("user@example.com"),
+	}
+	return s.startGlobalOrganizationLRO(ctx, op, func() (proto.Message, error) {
+		return obj, nil
+	})
+}
