+// Added by config-connector-extensions (patch 0007): managed identities in a
+// workload identity pool namespace, as the IAM v1 API documents them, with
+// their attestation rules. Like a namespace, a deleted managed identity is
+// soft-deleted (state DELETED) and its ID cannot be reused. A managed
+// identity must be in an existing, active namespace; the pool is not checked.
+
+package mockiam
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	longrunningpb "google.golang.org/genproto/googleapis/longrunning"
+
+	pbwip "github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/generated/mockgcp/iam/v1"
+	"github.com/GoogleCloudPlatform/k8s-config-connector/mockgcp/pkg/storage"
+)
+
+type WorkloadIdentityPoolManagedIdentitiesServer struct {
+	*MockService
+	pbwip.UnimplementedWorkloadIdentityPoolManagedIdentitiesServer
+}
+
+type managedIdentityName struct {
+	namespace namespaceName
+	ID        string
+}
+
+func (n *managedIdentityName) String() string {
+	return n.namespace.String() + "/managedIdentities/" + n.ID
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) parseName(name string) (*managedIdentityName, error) {
+	i := strings.LastIndex(name, "/managedIdentities/")
+	if i < 0 || strings.Contains(name[i+len("/managedIdentities/"):], "/") {
+		return nil, status.Errorf(codes.InvalidArgument, "name %q is not valid", name)
+	}
+	ns, err := (&WorkloadIdentityPoolNamespacesServer{MockService: s.MockService}).parseNamespaceName(name[:i])
+	if err != nil {
+		return nil, err
+	}
+	return &managedIdentityName{namespace: *ns, ID: name[i+len("/managedIdentities/"):]}, nil
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) get(ctx context.Context, name string) (*managedIdentityName, *pbwip.WorkloadIdentityPoolManagedIdentity, error) {
+	n, err := s.parseName(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	obj := &pbwip.WorkloadIdentityPoolManagedIdentity{}
+	if err := s.storage.Get(ctx, n.String(), obj); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return nil, nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+		}
+		return nil, nil, err
+	}
+	return n, obj, nil
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) lro(ctx context.Context, n *managedIdentityName, result proto.Message) (*longrunningpb.Operation, error) {
+	result = proto.Clone(result)
+	return s.operations.StartLRO(ctx, n.String(), &pbwip.WorkloadIdentityPoolOperationMetadata{}, func() (proto.Message, error) {
+		return result, nil
+	})
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) GetWorkloadIdentityPoolManagedIdentity(ctx context.Context, req *pbwip.GetWorkloadIdentityPoolManagedIdentityRequest) (*pbwip.WorkloadIdentityPoolManagedIdentity, error) {
+	_, obj, err := s.get(ctx, req.GetName())
+	return obj, err
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) CreateWorkloadIdentityPoolManagedIdentity(ctx context.Context, req *pbwip.CreateWorkloadIdentityPoolManagedIdentityRequest) (*longrunningpb.Operation, error) {
+	n, err := s.parseName(req.GetParent() + "/managedIdentities/" + req.GetWorkloadIdentityPoolManagedIdentityId())
+	if err != nil {
+		return nil, err
+	}
+	ns := &pbwip.WorkloadIdentityPoolNamespace{}
+	if err := s.storage.Get(ctx, n.namespace.String(), ns); err != nil || ns.State == pbwip.WorkloadIdentityPoolNamespace_DELETED {
+		return nil, status.Errorf(codes.NotFound, "Namespace %s was not found.", n.namespace.String())
+	}
+	obj := proto.Clone(req.GetWorkloadIdentityPoolManagedIdentity()).(*pbwip.WorkloadIdentityPoolManagedIdentity)
+	obj.Name = n.String()
+	obj.State = pbwip.WorkloadIdentityPoolManagedIdentity_ACTIVE
+	obj.ExpireTime = nil
+	if err := s.storage.Create(ctx, n.String(), obj); err != nil {
+		if status.Code(err) == codes.AlreadyExists {
+			return nil, status.Errorf(codes.AlreadyExists, "Managed identity %s already exists.", n.String())
+		}
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) UpdateWorkloadIdentityPoolManagedIdentity(ctx context.Context, req *pbwip.UpdateWorkloadIdentityPoolManagedIdentityRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetWorkloadIdentityPoolManagedIdentity().GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State == pbwip.WorkloadIdentityPoolManagedIdentity_DELETED {
+		return nil, status.Errorf(codes.FailedPrecondition, "Managed identity %s is deleted.", n.String())
+	}
+	for _, path := range req.GetUpdateMask().GetPaths() {
+		switch path {
+		case "description":
+			obj.Description = req.GetWorkloadIdentityPoolManagedIdentity().GetDescription()
+		case "disabled":
+			obj.Disabled = req.GetWorkloadIdentityPoolManagedIdentity().GetDisabled()
+		default:
+			return nil, status.Errorf(codes.InvalidArgument, "update_mask path %q not supported by mockgcp", path)
+		}
+	}
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) DeleteWorkloadIdentityPoolManagedIdentity(ctx context.Context, req *pbwip.DeleteWorkloadIdentityPoolManagedIdentityRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State == pbwip.WorkloadIdentityPoolManagedIdentity_DELETED {
+		return nil, status.Errorf(codes.NotFound, "Requested entity was not found.")
+	}
+	obj.State = pbwip.WorkloadIdentityPoolManagedIdentity_DELETED
+	obj.ExpireTime = timestamppb.New(time.Now().Add(30 * 24 * time.Hour))
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) UndeleteWorkloadIdentityPoolManagedIdentity(ctx context.Context, req *pbwip.UndeleteWorkloadIdentityPoolManagedIdentityRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetName())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State != pbwip.WorkloadIdentityPoolManagedIdentity_DELETED {
+		return nil, status.Errorf(codes.FailedPrecondition, "Managed identity %s is not deleted.", n.String())
+	}
+	obj.State = pbwip.WorkloadIdentityPoolManagedIdentity_ACTIVE
+	obj.ExpireTime = nil
+	if err := s.storage.Update(ctx, n.String(), obj); err != nil {
+		return nil, err
+	}
+	return s.lro(ctx, n, obj)
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) ListWorkloadIdentityPoolManagedIdentities(ctx context.Context, req *pbwip.ListWorkloadIdentityPoolManagedIdentitiesRequest) (*pbwip.ListWorkloadIdentityPoolManagedIdentitiesResponse, error) {
+	resp := &pbwip.ListWorkloadIdentityPoolManagedIdentitiesResponse{}
+	kind := (&pbwip.WorkloadIdentityPoolManagedIdentity{}).ProtoReflect().Descriptor()
+	if err := s.storage.List(ctx, kind, storage.ListOptions{Prefix: req.GetParent() + "/managedIdentities/"}, func(obj proto.Message) error {
+		mi := obj.(*pbwip.WorkloadIdentityPoolManagedIdentity)
+		if mi.State != pbwip.WorkloadIdentityPoolManagedIdentity_DELETED || req.GetShowDeleted() {
+			resp.WorkloadIdentityPoolManagedIdentities = append(resp.WorkloadIdentityPoolManagedIdentities, mi)
+		}
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return resp, nil
+}
+
+func rulesKey(n *managedIdentityName) string {
+	return n.String() + "/attestationRules"
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) SetAttestationRules(ctx context.Context, req *pbwip.SetAttestationRulesRequest) (*longrunningpb.Operation, error) {
+	n, obj, err := s.get(ctx, req.GetResource())
+	if err != nil {
+		return nil, err
+	}
+	if obj.State == pbwip.WorkloadIdentityPoolManagedIdentity_DELETED {
+		return nil, status.Errorf(codes.FailedPrecondition, "Managed identity %s is deleted.", n.String())
+	}
+	for _, r := range req.GetAttestationRules() {
+		if r.GetGoogleCloudResource() == "" {
+			return nil, status.Errorf(codes.InvalidArgument, "attestation rule must set google_cloud_resource")
+		}
+	}
+	if len(req.GetAttestationRules()) > 50 {
+		return nil, status.Errorf(codes.InvalidArgument, "at most 50 attestation rules")
+	}
+	rules := &pbwip.ManagedIdentityAttestationRules{Name: rulesKey(n), AttestationRules: req.GetAttestationRules()}
+	if err := s.storage.Update(ctx, rulesKey(n), rules); err != nil {
+		if status.Code(err) != codes.NotFound {
+			return nil, err
+		}
+		if err := s.storage.Create(ctx, rulesKey(n), rules); err != nil {
+			return nil, err
+		}
+	}
+	return s.lro(ctx, n, &pbwip.SetAttestationRulesResponse{})
+}
+
+func (s *WorkloadIdentityPoolManagedIdentitiesServer) ListAttestationRules(ctx context.Context, req *pbwip.ListAttestationRulesRequest) (*pbwip.ListAttestationRulesResponse, error) {
+	n, _, err := s.get(ctx, req.GetResource())
+	if err != nil {
+		return nil, err
+	}
+	rules := &pbwip.ManagedIdentityAttestationRules{}
+	if err := s.storage.Get(ctx, rulesKey(n), rules); err != nil {
+		if status.Code(err) == codes.NotFound {
+			return &pbwip.ListAttestationRulesResponse{}, nil
+		}
+		return nil, err
+	}
+	return &pbwip.ListAttestationRulesResponse{AttestationRules: rules.GetAttestationRules()}, nil
+}
