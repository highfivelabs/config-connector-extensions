+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package directbase
+
+// A cloud API's refusal for quota (HTTP 429, gRPC RESOURCE_EXHAUSTED) says
+// "not now", not "this object is wrong". With Deps.QuotaBackoff set, such a
+// refusal does not mark the object failed: the reconciler leaves its
+// status alone and tries again after a wait that grows with each refusal
+// in a row. config-connector-extensions patch 0047.
+
+import (
+	"errors"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/googleapis/gax-go/v2/apierror"
+	"google.golang.org/api/googleapi"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+// IsQuotaExhausted reports whether err, or an error it wraps, is a cloud
+// API's refusal for quota: HTTP 429 or gRPC RESOURCE_EXHAUSTED.
+func IsQuotaExhausted(err error) bool {
+	if err == nil {
+		return false
+	}
+	var ge *googleapi.Error
+	if errors.As(err, &ge) && ge.Code == http.StatusTooManyRequests {
+		return true
+	}
+	var ae *apierror.APIError
+	if errors.As(err, &ae) {
+		if ae.HTTPCode() == http.StatusTooManyRequests {
+			return true
+		}
+		if s := ae.GRPCStatus(); s != nil && s.Code() == codes.ResourceExhausted {
+			return true
+		}
+	}
+	var gs interface{ GRPCStatus() *status.Status }
+	if errors.As(err, &gs) {
+		if s := gs.GRPCStatus(); s != nil && s.Code() == codes.ResourceExhausted {
+			return true
+		}
+	}
+	return false
+}
+
+// quotaRefusedError is a reconcile that the cloud refused for quota; the
+// object's status was left as it was.
+type quotaRefusedError struct {
+	err error
+}
+
+func (e *quotaRefusedError) Error() string { return "refused for quota: " + e.err.Error() }
+
+func (e *quotaRefusedError) Unwrap() error { return e.err }
+
+// quotaRefusals counts each object's refusals for quota in a row.
+type quotaRefusals struct {
+	mu sync.Mutex
+	n  map[types.NamespacedName]int
+}
+
+// next is the wait before the object's next try, given backoff.
+func (q *quotaRefusals) next(nn types.NamespacedName, backoff func(int) time.Duration) time.Duration {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.n == nil {
+		q.n = map[types.NamespacedName]int{}
+	}
+	n := q.n[nn]
+	q.n[nn]++
+	return backoff(n)
+}
+
+func (q *quotaRefusals) forget(nn types.NamespacedName) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	delete(q.n, nn)
+}
