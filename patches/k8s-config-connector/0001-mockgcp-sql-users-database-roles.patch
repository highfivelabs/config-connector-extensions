config-connector-extensions patch 0001: mockgcp Cloud SQL users learn database roles.

mockgcp's User proto (googleapis 731d7f2, mockgcp/git.versions) predates
User.database_roles and the update request's database_roles /
revoke_existing_roles. This adds them with googleapis master's field numbers
(regenerated by hack/regen-mocksql-users.sh with mockgcp's own pinned
protoc toolchain), and makes users.update apply the roles as the API
documents: body.database_roles is ignored; the request's roles are added to
the existing ones, or replace them when revoke_existing_roles is set.

Upstream candidate: yes (mockgcp is upstream's fake; this is a fix to it).

diff --git a/mockgcp/generated/mockgcp/cloud/sql/v1beta4/cloud_sql_users.pb.go b/mockgcp/generated/mockgcp/cloud/sql/v1beta4/cloud_sql_users.pb.go
index 69cefda3..41b20b81 100644
--- a/mockgcp/generated/mockgcp/cloud/sql/v1beta4/cloud_sql_users.pb.go
+++ b/mockgcp/generated/mockgcp/cloud/sql/v1beta4/cloud_sql_users.pb.go
@@ -446,6 +446,13 @@ type SqlUsersUpdateRequest struct {
 	// Project ID of the project that contains the instance.
 	Project string `protobuf:"bytes,4,opt,name=project,proto3" json:"project,omitempty"`
 	Body    *User  `protobuf:"bytes,100,opt,name=body,proto3" json:"body,omitempty"`
+	// Optional. List of database roles to grant to the user. body.database_roles
+	// will be ignored for update request.
+	DatabaseRoles []string `protobuf:"bytes,5,rep,name=database_roles,json=databaseRoles,proto3" json:"database_roles,omitempty"`
+	// Optional. Specifies whether to revoke existing roles that are not present
+	// in the `database_roles` field. If `false` or unset, the database roles
+	// specified in `database_roles` are added to the user's existing roles.
+	RevokeExistingRoles *bool `protobuf:"varint,6,opt,name=revoke_existing_roles,json=revokeExistingRoles,proto3,oneof" json:"revoke_existing_roles,omitempty"`
 }
 
 func (x *SqlUsersUpdateRequest) Reset() {
@@ -515,6 +522,20 @@ func (x *SqlUsersUpdateRequest) GetBody() *User {
 	return nil
 }
 
+func (x *SqlUsersUpdateRequest) GetDatabaseRoles() []string {
+	if x != nil {
+		return x.DatabaseRoles
+	}
+	return nil
+}
+
+func (x *SqlUsersUpdateRequest) GetRevokeExistingRoles() bool {
+	if x != nil && x.RevokeExistingRoles != nil {
+		return *x.RevokeExistingRoles
+	}
+	return false
+}
+
 // User level password validation policy.
 type UserPasswordValidationPolicy struct {
 	state         protoimpl.MessageState
@@ -703,6 +724,8 @@ type User struct {
 	// Dual password status for the user.
 	DualPasswordType *User_DualPasswordType `protobuf:"varint,13,opt,name=dual_password_type,json=dualPasswordType,proto3,enum=mockgcp.cloud.sql.v1beta4.User_DualPasswordType,oneof" json:"dual_password_type,omitempty"`
 	IamStatus        *string                `protobuf:"bytes,16,opt,name=iam_status,json=iamStatus,proto3,oneof" json:"iam_status,omitempty"`
+	// Optional. Role memberships of the user
+	DatabaseRoles []string `protobuf:"bytes,15,rep,name=database_roles,json=databaseRoles,proto3" json:"database_roles,omitempty"`
 }
 
 func (x *User) Reset() {
@@ -828,6 +851,13 @@ func (x *User) GetIamStatus() string {
 	return ""
 }
 
+func (x *User) GetDatabaseRoles() []string {
+	if x != nil {
+		return x.DatabaseRoles
+	}
+	return nil
+}
