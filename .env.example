#
# Environment identifiers, kept out of the tree. Copy to .env (git-ignored)
# and fill in; `task` loads .env, and hack/ci/gate.sh reads it too. Nothing
# here falls back to a default: a script that needs a variable that is unset
# stops and names it. On an offload VM a value reaches a run only through
# `env NAME=...` on the offload command line.

# The live-test Google Cloud project (task test-live, live-sweep, live-list;
# hack/live/projects.sh allows only this one, the fallback and the pattern below).
GCP_PROJECT=example-project-id

# Optional: a bash regexp for the test estate's generation projects and
# their scratch projects, also allowed for live runs. Empty: none.
GCP_LIVE_PROJECT_PATTERN=

# Optional: the previous dev project, also allowed for live runs (never the
# default) as a fallback until GCP_PROJECT's quota matches it. Empty: none.
GCP_LIVE_FALLBACK_PROJECT=

# Optional: the test estate's project for this generation; overrides
# GCP_PROJECT for the live tasks (factory/estate/gcp/<gen>.env writes it).
# HFL_GCP_TEST_PROJECT=

# The live-test service account an offload VM runs as (offload run --sa).
GCP_LIVE_SA=live-tests@example-project-id.iam.gserviceaccount.com

# The offload VMs' project and bucket (hack/ci/gate.sh; offload reads them too).
OFFLOAD_PROJECT=example-project-id
OFFLOAD_BUCKET=gs://example-offload-bucket

# GitHub repository variables (Settings > Secrets and variables > Actions >
# Variables) the disabled workflows read as ${{ vars.NAME }}; not read locally:
#   GCP_PROJECT                      the registry's project (release.yml)
#   OFFLOAD_PROJECT                  the Spot runners' project (spot-runner)
#   GCP_WORKLOAD_IDENTITY_PROVIDER   projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
#   FACTORY_OFFLOAD_SERVICE_ACCOUNT  the account that starts Spot runners
#   RELEASE_SERVICE_ACCOUNT          the account that pushes release images
